walker/filter_list_scaling/10000	17.000
walker/comprehension_scaling/10	12.000
walker/comprehension_scaling/50	16.000
walker/comprehension_scaling/100	18.000
walker/comprehension_scaling/500	22.000
walker/string_operations	8.000
walker/member_call_on_variable	11.000
